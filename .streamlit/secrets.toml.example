LLM_BASE_URL = "http://localhost:9931/v1"
LLM_API_KEY = "no-key-required"

ICD_TOKEN_ENDPOINT = "https://icdaccessmanagement.who.int/connect/token"
ICD_CLIENT_ID = "icd-client-id"
ICD_CLIENT_SECRET = "icd-client-secret"

# Optional MIMIC connection
[connections.postgresql]
dialect = "postgresql"
host = "mimiciv-host"
port = "5432"
database = "mimiciv"
username = "postgres"
password = "mimiciv-password"

# Results database
[connections.sqlite]
url = "sqlite:///database.db"